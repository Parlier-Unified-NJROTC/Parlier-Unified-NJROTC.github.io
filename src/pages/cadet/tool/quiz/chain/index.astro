---

import Layout from "../../../../../layouts/Layout.astro";

---
<Layout title="General Orders Quiz" disableHero fancyBackground>
<div id="settingsPanel" class="settings-panel">
    <h1>US NAVY GENERAL ORDERS</h1>
    <p>Configure difficulty & start quiz</p>
    <div class="difficulty-box">
        <label>DIFFICULTY LEVEL</label>
        <input type="range" id="difficultySliderModal" min="1" max="3" step="1" value="1">
        <div class="difficulty-value" id="difficultyLabelModal">EASY MODE</div>
    </div>
    <button id="startQuizBtn" class="start-btn">START QUIZ</button>
    <div style="margin-top: 20px; font-size: 0.8rem; color: #aaa;">Auto-advance after 10s | 3 window exit = auto-close</div>
</div>

<div id="quizModal" class="quiz-modal">
    <div class="quiz-modal-content">
        <button id="closeModalBtn" class="close-modal-btn" aria-label="Close">×</button>
        <div class="quiz-header">
            <h2>GENERAL ORDERS CHALLENGE</h2>
        </div>
        <div class="stats-row">
            <div class="score-board">SCORE: <span id="modalScore">0</span> pts</div>
        </div>
        <div class="question-area">
            <div class="question-text" id="modalQuestionText">Loading general orders...</div>
            <div class="answers-grid" id="modalAnswersContainer"></div>
            <div class="feedback-area">
                <div class="feedback-message" id="modalFeedback">Select an answer</div>
                <div class="timer-info" id="modalTimerInfo">Next in --s</div>
            </div>
            <div style="margin-top: 12px; text-align: center;">
            </div>
        </div>
        <div id="modalTerminationMsg" style="padding: 0 1.5rem 1.5rem;"></div>
    </div>
</div>

    <style is:inline>

        .BG555 {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 1rem;
        }

        .settings-panel {
            max-width: 550px;
            width: 100%;
            background: rgba(8, 12, 25, 0.95);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(230, 178, 32, 0.5);
            border-radius: 15px;
            box-shadow: 0 25px 40px rgba(0,0,0,0.6);
            padding: 2rem 2rem 2.5rem;
            text-align: center;
            transition: 0.2s;
        }

        .settings-panel h1 {
            font-size: 1.9rem;
            letter-spacing: 1px;
            color: #e6b220;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        .settings-panel p {
            color: #bbbbdd;
            margin-bottom: 2rem;
            font-weight: 500;
        }

        .difficulty-box {
            background: #07152a;
            border-radius: 15px;
            padding: 1rem 1.5rem;
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .difficulty-box label {
            font-weight: 600;
            color: #ffdd99;
            font-size: 1rem;
        }

        input[type="range"] {
            width: 240px;
            height: 6px;
            -webkit-appearance: none;
            background: #2c3e66;
            border-radius: 3px;
            outline: none;
        }

        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 18px;
            height: 18px;
            background: #e6b220;
            border-radius: 50%;
            cursor: pointer;
            border: none;
            box-shadow: 0 0 4px rgba(0,0,0,0.5);
        }

        input[type="range"]::-moz-range-thumb {
            width: 18px;
            height: 18px;
            background: #e6b220;
            border-radius: 50%;
            cursor: pointer;
            border: none;
        }

        .difficulty-value {
            background: #000000aa;
            padding: 6px 18px;
            border-radius: 15px;
            font-weight: bold;
            min-width: 120px;
            text-align: center;
            font-size: 0.9rem;
            color: #f5cb5c;
        }

        .start-btn {
            background: #e6b220;
            border: none;
            padding: 14px 32px;
            border-radius: 15px;
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
            color: #0b1a2a;
            box-shadow: 0 4px 12px black;
            width: 100%;
        }

        .start-btn:hover {
            background: #ffcd4a;
            transform: scale(1.01);
        }

        .quiz-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            backdrop-filter: blur(12px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.2s ease;
        }

        .quiz-modal-content {
            max-width: 950px;
            width: 90%;
            background: #0a1120e6;
            border: 2px solid #e6b220;
            border-radius: 15px;
            box-shadow: 0 20px 40px black;
            overflow: hidden;
            position: relative;
            max-height: 90vh;
            overflow-y: auto;
        }

        .quiz-header {
            background: linear-gradient(135deg, #011a31, #021e3a);
            padding: 1rem 1.5rem;
            border-bottom: 2px solid #e6b220;
            text-align: center;
        }

        .quiz-header h2 {
            font-size: 1.6rem;
            letter-spacing: 1px;
            color: #e6b220;
            font-weight: bold;
        }

        .stats-row {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            padding: 0.8rem 1.5rem;
            background: #030b16cc;
            gap: 0.8rem;
            border-bottom: 1px solid #2a3a55;
        }

        .score-board, .strike-board {
            background: #000000aa;
            padding: 6px 16px;
            border-radius: 15px;
            font-weight: bold;
            font-size: 0.95rem;
        }

        .question-area {
            padding: 1.5rem 1.5rem 1rem;
        }

        .question-text {
            background: #00000066;
            border-radius: 15px;
            padding: 1.5rem;
            font-size: 1.4rem;
            font-weight: 600;
            text-align: center;
            border-left: 6px solid #e6b220;
            margin-bottom: 1.5rem;
        }

        .answers-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .answer-btn {
            background: #0f1b2f;
            border: 2px solid #2a456b;
            border-radius: 15px;
            padding: 0.9rem 0.5rem;
            font-size: 0.95rem;
            font-weight: 500;
            text-align: center;
            color: #f0f3ff;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .answer-btn:hover:not(:disabled) {
            background: #1e2f4a;
            border-color: #e6b220;
            transform: scale(1.02);
        }

        .answer-btn.selected-correct {
            background: #1f8a4c !important;
            border-color: #2ecc71 !important;
            color: white !important;
        }

        .answer-btn.selected-wrong {
            background: #a1222a !important;
            border-color: #e74c3c !important;
            text-decoration: line-through;
            color: #ffcccc !important;
        }

        .answer-btn:disabled {
            cursor: not-allowed;
            opacity: 0.8;
        }

        .feedback-area {
            background: #030e1acc;
            border-radius: 15px;
            padding: 0.7rem 1.2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .feedback-message {
            color: #d4e6ff;
            font-weight: 500;
            font-size: 0.95rem;
        }

        .timer-info {
            font-family: monospace;
            font-weight: bold;
            color: #e6b220;
            background: #000000aa;
            padding: 5px 12px;
            border-radius: 15px;
            font-size: 0.9rem;
        }

        .reset-quiz-btn {
            background: #2c3e66;
            margin-top: 8px;
            padding: 6px 18px;
            border-radius: 15px;
            border: none;
            color: white;
            cursor: pointer;
            transition: 0.2s;
        }

        .reset-quiz-btn:hover {
            background: #3a5a8c;
            transform: scale(1.02);
        }

        .close-modal-btn {
            position: absolute;
            top: 12px;
            right: 20px;
            background: none;
            border: none;
            color: #e6b220;
            font-size: 28px;
            cursor: pointer;
            font-weight: bold;
            transition: 0.2s;
        }

        .close-modal-btn:hover {
            color: #ffcd4a;
            transform: scale(1.1);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }

        @media (max-width: 700px) {
            .answers-grid {
                grid-template-columns: 1fr;
            }
            .question-text {
                font-size: 1.1rem;
                padding: 1rem;
            }
            .stats-row {
                flex-direction: column;
                align-items: stretch;
            }
        }
    </style>

<script lang="javascript">
    (function() {
        const QUESTION_BANK = {
            easy: [
                { text: "What is the 1st General Order of a Sentry?", options: ["To take charge of this post and all government property in view.", "To salute all officers and all colors.", "To quit my post only when properly relieved.", "To walk my post in a military manner."], correctIndex: 0 },
                { text: "Which General Order states: 'To walk my post in a military manner, keeping always on the alert' ?", options: ["2nd General Order", "5th General Order", "1st General Order", "10th General Order"], correctIndex: 0 },
                { text: "According to the 6th General Order, what must the sentry do with orders from the Commanding Officer?", options: ["Receive, obey, and pass on to the relieving sentry.", "Write them down in a logbook.", "Only obey verbal commands.", "Ignore unless repeated twice."], correctIndex: 0 },
                { text: "The 10th General Order requires a sentry to:", options: ["Salute all officers and all colors not cased.", "Call the Officer of the Deck.", "Report all violations.", "Give the alarm in case of fire."], correctIndex: 0 },
                { text: "Which order forbids talking to anyone except in the line of duty?", options: ["7th General Order", "3rd General Order", "8th General Order", "11th General Order"], correctIndex: 0 },
                { text: "What action is described in the 5th General Order?", options: ["Quit my post only when properly relieved.", "Call the Officer of the Deck.", "Repeat all calls from distant posts.", "Be especially watchful at night."], correctIndex: 0 }
            ],
            medium: [
                { text: "Complete the 2nd General Order: 'To walk my post in a military manner, keeping always on the alert and observing everything that takes place ______.'", options: ["within sight or hearing", "within the base perimeter", "during my watch", "under my command"], correctIndex: 0 },
                { text: "Fill in: 'To ___ all calls from posts more distant from the guardhouse than my own.' (4th Order)", options: ["repeat", "report", "relay", "record"], correctIndex: 0 },
                { text: "The 8th General Order instructs the sentry to give the alarm in case of:", options: ["Fire or disorder", "Enemy attack", "Unauthorized personnel", "Officer inspection"], correctIndex: 0 },
                { text: "According to the 9th General Order, when should you call the Officer of the Deck?", options: ["In any case not covered by instructions.", "When a superior officer approaches.", "Every hour on the hour.", "Only during nighttime."], correctIndex: 0 },
                { text: "The 11th General Order says: 'To be especially watchful at night and during the time for challenging, to challenge all persons on or near my post, and to allow no one to pass ______.'", options: ["without proper authority", "without identification", "unless in uniform", "after midnight"], correctIndex: 0 }
            ],
            hard: [
                { text: "Scenario: You are on watch at the quarterdeck. A civilian contractor without a badge tries to enter. According to the General Orders, which two orders are MOST relevant?", options: ["1st & 11th (take charge & challenge unauthorized)", "2nd & 7th (alertness & silence)", "4th & 8th (repeat calls & fire alarm)", "5th & 9th (relief & OOD call)"], correctIndex: 0 },
                { text: "Scenario: While on night watch, you see a small fire near the supply shed. Based on the General Orders, you should FIRST:", options: ["Give the alarm (8th Order)", "Call the Officer of the Deck (9th Order)", "Attempt to extinguish it (not in orders)", "Report violation to the commander (3rd Order)"], correctIndex: 0 },
                { text: "You notice an officer approaching your post. According to the 10th General Order, you must:", options: ["Salute the officer", "Challenge the officer", "Report the officer's presence", "Ignore unless spoken to"], correctIndex: 0 },
                { text: "Your relief is late by 20 minutes. Which General Order directly applies to this situation?", options: ["5th Order: quit post only when properly relieved", "6th Order: pass on orders", "2nd Order: stay alert", "3rd Order: report violation"], correctIndex: 0 }
            ]
        };

        const POINTS_MAP = { 1: 10, 2: 20, 3: 30 };

        let currentDifficulty = 1;
        let currentQuestionsList = [];
        let currentQuestionObj = null;
        let currentScore = 0;
        let focusStrikeCount = 0;
        let quizActive = true;
        let waitingForNext = false;
        let autoAdvanceTimer = null;
        let countdownInterval = null;
        let hasAnsweredCurrent = false;

        let modalScoreSpan, modalStrikeSpan, modalQuestionText, modalAnswersContainer, modalFeedback, modalTimerInfo, modalTerminationDiv, modalResetBtn, closeModalBtn, modalElement;

        function getDifficultyData(level) {
            if (level === 1) return { key: "easy", list: QUESTION_BANK.easy };
            if (level === 2) return { key: "medium", list: QUESTION_BANK.medium };
            return { key: "hard", list: QUESTION_BANK.hard };
        }

        function getRandomQuestion(avoidQuestion = null) {
            if (!currentQuestionsList.length) return null;
            let filtered = avoidQuestion ? currentQuestionsList.filter(q => q !== avoidQuestion) : currentQuestionsList;
            if (filtered.length === 0) filtered = currentQuestionsList;
            const rand = Math.floor(Math.random() * filtered.length);
            return { ...filtered[rand] };
        }

        function clearAutoTimers() {
            if (autoAdvanceTimer) {
                clearTimeout(autoAdvanceTimer);
                autoAdvanceTimer = null;
            }
            if (countdownInterval) {
                clearInterval(countdownInterval);
                countdownInterval = null;
            }
            if (modalTimerInfo) modalTimerInfo.innerText = "Next in --s";
            modalTimerInfo.style.opacity = '0';
        }

        function startAutoAdvance() {
            clearAutoTimers();
            let remaining = 10;
            modalTimerInfo.style.opacity = '1';
            modalTimerInfo.innerText = `Next in ${remaining}s`;
            
            countdownInterval = setInterval(() => {
                if (!quizActive || !waitingForNext) {
                    if (countdownInterval) clearInterval(countdownInterval);
                    return;
                }
                remaining--;
                if (remaining >= 0) {
                    modalTimerInfo.innerText = `Next in ${remaining}s`;
                }
                if (remaining <= 0) {
                    if (countdownInterval) clearInterval(countdownInterval);
                }
            }, 1000);
            
            autoAdvanceTimer = setTimeout(() => {
                if (quizActive && waitingForNext) {
                    loadFreshQuestion(true);
                    waitingForNext = false;
                    hasAnsweredCurrent = false;
                    modalTimerInfo.innerText = "Next in --s";
                    modalTimerInfo.style.opacity = '0';
                    modalFeedback.innerText = "New question. Choose answer.";
                }
                clearAutoTimers();
            }, 10000);
        }

        function renderQuestion() {
            if (!quizActive) return;
            if (!currentQuestionObj) {
                loadFreshQuestion();
                return;
            }
            modalQuestionText.innerText = currentQuestionObj.text;
            modalAnswersContainer.innerHTML = '';
            
            currentQuestionObj.options.forEach((opt, idx) => {
                const btn = document.createElement('div');
                btn.className = 'answer-btn';
                btn.innerText = opt;
                btn.setAttribute('data-index', idx);
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    onAnswer(parseInt(this.getAttribute('data-index')));
                });
                if (hasAnsweredCurrent || waitingForNext || !quizActive) {
                    btn.style.pointerEvents = 'none';
                }
                modalAnswersContainer.appendChild(btn);
            });
            
            if (!hasAnsweredCurrent && !waitingForNext) {
                modalFeedback.innerText = "Select an answer";
            }
        }

        function loadFreshQuestion(resetAnswerState = true) {
            if (!quizActive) return;
            const newQ = getRandomQuestion(currentQuestionObj);
            if (newQ) currentQuestionObj = newQ;
            else if (currentQuestionsList.length) currentQuestionObj = { ...currentQuestionsList[0] };
            
            if (resetAnswerState) {
                hasAnsweredCurrent = false;
                waitingForNext = false;
                clearAutoTimers();
                modalTimerInfo.innerText = "Next in --s";
                modalTimerInfo.style.opacity = '0';
            }
            renderQuestion();
        }

        function onAnswer(selectedIdx) {
            if (!quizActive || hasAnsweredCurrent || waitingForNext) return;
            
            const isCorrect = (selectedIdx === currentQuestionObj.correctIndex);
            const allBtns = document.querySelectorAll('#modalAnswersContainer .answer-btn');
            
            allBtns.forEach((btn, idx) => {
                btn.style.pointerEvents = 'none';
                if (idx === currentQuestionObj.correctIndex) {
                    btn.classList.add('selected-correct');
                }
                if (idx === selectedIdx && !isCorrect) {
                    btn.classList.add('selected-wrong');
                }
            });
            
            if (isCorrect) {
                let points = POINTS_MAP[currentDifficulty];
                currentScore += points;
                modalScoreSpan.innerText = currentScore;
                modalFeedback.innerText = `CORRECT! +${points} points. Next question in 10 seconds.`;
            } else {
                const correctAns = currentQuestionObj.options[currentQuestionObj.correctIndex];
                modalFeedback.innerText = `WRONG! Correct answer: "${correctAns}". Next in 10 seconds.`;
            }
            
            hasAnsweredCurrent = true;
            waitingForNext = true;
            startAutoAdvance();
        }

        function applyFocusStrike() {
            if (!quizActive) return;
            if (focusStrikeCount >= 3) return;
            
            focusStrikeCount++;
            const remaining = 3 - focusStrikeCount;
            modalFeedback.innerText = `FOCUS LOST! Question changes immediately. (${remaining} strike(s) left)`;
            
            if (waitingForNext) {
                clearAutoTimers();
                waitingForNext = false;
            }
            
            if (quizActive) {
                loadFreshQuestion(true);
                hasAnsweredCurrent = false;
                waitingForNext = false;
                modalTimerInfo.innerText = "Next in --s";
            }
            
            if (focusStrikeCount >= 3) {
                terminateAndCloseModal();
            }
        }

        function terminateAndCloseModal() {
            if (!quizActive) return;
            quizActive = false;
            clearAutoTimers();
            modalTerminationDiv.innerHTML = `<div style="background:#b91c1ccc; border-radius:15px; padding:12px; text-align:center; margin-top: 10px;">TEST TERMINATED: Maximum focus strikes (3). Closing quiz popup.</div>`;
            document.querySelectorAll('#modalAnswersContainer .answer-btn').forEach(btn => {
                btn.style.pointerEvents = 'none';
            });
            setTimeout(() => {
                closeModal();
            }, 1800);
        }

        function resetQuizInsideModal() {
            if (!modalElement || modalElement.style.display !== 'flex') return;
            
            currentScore = 0;
            focusStrikeCount = 0;
            quizActive = true;
            waitingForNext = false;
            hasAnsweredCurrent = false;
            clearAutoTimers();
            modalScoreSpan.innerText = "0";
            modalStrikeSpan.innerText = "0";
            modalTerminationDiv.innerHTML = "";
            
            const diffData = getDifficultyData(currentDifficulty);
            currentQuestionsList = diffData.list;
            currentQuestionObj = getRandomQuestion(null);
            renderQuestion();
            modalFeedback.innerText = "Quiz restarted. Stay focused! Single press answers.";
            modalTimerInfo.innerText = "Next in --s";
        }

        function closeModal() {
            if (!modalElement) return;
            clearAutoTimers();
            modalElement.style.display = 'none';
            window.removeEventListener('blur', blurHandler);
            document.removeEventListener('visibilitychange', visibilityHandler);
            const settingsPanel = document.getElementById('settingsPanel');
            if (settingsPanel) settingsPanel.style.display = 'block';
            quizActive = false;
        }

        let blurHandler = function() { 
            if (modalElement && modalElement.style.display === 'flex' && quizActive) applyFocusStrike(); 
        };
        
        let visibilityHandler = function() { 
            if (document.hidden && modalElement && modalElement.style.display === 'flex' && quizActive) applyFocusStrike(); 
        };

        function openModal() {
            const settingsSlider = document.getElementById('difficultySliderModal');
            const diffVal = parseInt(settingsSlider.value);
            currentDifficulty = diffVal;
            const diffData = getDifficultyData(currentDifficulty);
            currentQuestionsList = diffData.list;
            currentScore = 0;
            focusStrikeCount = 0;
            quizActive = true;
            waitingForNext = false;
            hasAnsweredCurrent = false;
            clearAutoTimers();
            modalScoreSpan.innerText = "0";
            modalTerminationDiv.innerHTML = "";
            currentQuestionObj = getRandomQuestion(null);
            renderQuestion();
            modalFeedback.innerText = "Quiz started. Auto-advance after 10 seconds per answer.";
            modalTimerInfo.innerText = "Next in --s";
            modalElement.style.display = 'flex';
            window.addEventListener('blur', blurHandler);
            document.addEventListener('visibilitychange', visibilityHandler);
        }

        document.addEventListener('DOMContentLoaded', function() {
            modalElement = document.getElementById('quizModal');
            modalScoreSpan = document.getElementById('modalScore');
            modalStrikeSpan = document.getElementById('modalStrike');
            modalQuestionText = document.getElementById('modalQuestionText');
            modalAnswersContainer = document.getElementById('modalAnswersContainer');
            modalFeedback = document.getElementById('modalFeedback');
            modalTimerInfo = document.getElementById('modalTimerInfo');
            modalTerminationDiv = document.getElementById('modalTerminationMsg');
            modalResetBtn = document.getElementById('modalResetInsideBtn');
            closeModalBtn = document.getElementById('closeModalBtn');

            const startBtn = document.getElementById('startQuizBtn');
            const diffSliderSettings = document.getElementById('difficultySliderModal');
            const diffLabelSettings = document.getElementById('difficultyLabelModal');
            
            function updateSettingsLabel() {
                const val = parseInt(diffSliderSettings.value);
                if (val === 1) diffLabelSettings.innerText = "EASY MODE (10 pts)";
                else if (val === 2) diffLabelSettings.innerText = "MEDIUM MODE (20 pts)";
                else diffLabelSettings.innerText = "HARD MODE (30 pts)";
            }
            
            diffSliderSettings.addEventListener('input', updateSettingsLabel);
            updateSettingsLabel();
            
            startBtn.addEventListener('click', function() {
                document.getElementById('settingsPanel').style.display = 'none';
                openModal();
            });
            
            if (modalResetBtn) {
                modalResetBtn.addEventListener('click', resetQuizInsideModal);
            }
            if (closeModalBtn) {
                closeModalBtn.addEventListener('click', function() {
                    closeModal();
                    document.getElementById('settingsPanel').style.display = 'block';
                });
            }
            
            const originalBodyOverflow = document.body.style.overflow;
            const modalObserver = new MutationObserver((mutations) => {
                mutations.forEach((mut) => {
                    if (mut.type === 'attributes' && mut.attributeName === 'style') {
                        if (modalElement && modalElement.style.display === 'flex') {
                            document.body.style.overflow = 'hidden';
                        } else {
                            document.body.style.overflow = originalBodyOverflow || '';
                        }
                    }
                });
            });
            if (modalElement) {
                modalObserver.observe(modalElement, { attributes: true });
                if (modalElement.style.display === 'flex') document.body.style.overflow = 'hidden';
                else document.body.style.overflow = originalBodyOverflow || '';
            }
        });
    })();
</script>