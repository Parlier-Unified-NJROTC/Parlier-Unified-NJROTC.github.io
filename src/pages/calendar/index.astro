---
import Layout from "../../layouts/Layout.astro";
import Rolling from "../../components/Rolling.astro";

// Style & JS
import "../../style/calendar.css";
---

<Layout title="Parlier Unified" subtitle="NJROTC" disableHero>
<div class="BG555">
    <div class="container">
        <div class="content-wrapper">
            <div class="calendar-section">
                <div class="iframe-wrapper" id="iframeWrapper">
                    <iframe 
                        id="calendarFrame"
                        src=""
                        title="NJROTC Monthly Calendar"
                        scrolling="auto"
                        class="calendar-iframe"
                    >
                    </iframe>
                    <div class="click-overlay">
                        <span class="click-hint">Click to open full PDF</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script lang="js">
    let currentDate = new Date();
    let currentYear = currentDate.getFullYear();
    let currentMonth = currentDate.getMonth(); 
    
    const monthNames = [
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"
    ];
    
    let currentPdfPath = "";
    
    function updateCalendarPDF(year, month) {
        const monthName = monthNames[month];
        const pdfPath = `/calder/${monthName}_${year}.pdf`;
        currentPdfPath = pdfPath;
        
        const iframe = document.getElementById('calendarFrame');
        iframe.src = pdfPath;
    }
    
    updateCalendarPDF(currentYear, currentMonth);
    
    const iframeWrapper = document.getElementById('iframeWrapper');
    if (iframeWrapper) {
        iframeWrapper.addEventListener('click', function(e) {
            e.stopPropagation();
            if (currentPdfPath) {
                window.open(currentPdfPath, '_blank');
            }
        });
    }
</script>

</Layout>