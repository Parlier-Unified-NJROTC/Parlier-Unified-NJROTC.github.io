    }

    .start-btn:hover {
        background: #ffcd4a;
        transform: scale(1.01);
    }

    .quiz-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.95);
        backdrop-filter: blur(12px);
        z-index: 2000;
        justify-content: center;
        align-items: center;
        animation: fadeIn 0.2s ease;
    }

    .quiz-modal-content {
        max-width: 950px;
        width: 90%;
        background: #0a1120e6;
        border: 2px solid #e6b220;
        border-radius: 15px;
