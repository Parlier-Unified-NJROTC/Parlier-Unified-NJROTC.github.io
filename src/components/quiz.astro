        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .feedback-message {
        color: #d4e6ff;
        font-weight: 500;
        font-size: 0.95rem;
    }

    .timer-info {
        font-family: monospace;
        font-weight: bold;
        color: #e6b220;
        background: #000000aa;
        padding: 5px 12px;
        border-radius: 15px;
        font-size: 0.9rem;
    }

    .reset-quiz-btn {
        background: #2c3e66;
        margin-top: 8px;
        padding: 6px 18px;
        border-radius: 15px;
