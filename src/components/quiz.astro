---
// components/quiz.astro
export interface Props {
  questionBank?: {
    easy: any[];
    medium: any[];
    hard: any[];
  };
  QUIZ: string;
}
const {
    QUIZ,
} = Astro.props;

const { questionBank } = Astro.props;
---

<div id="settingsPanel" class="settings-panel">
    <h1>{QUIZ} ORDERS</h1>
    <p>Configure difficulty & start quiz</p>
    <div class="difficulty-box">
        <label>DIFFICULTY LEVEL</label>
        <input type="range" id="difficultySliderModal" min="1" max="3" step="1" value="1">
        <div class="difficulty-value" id="difficultyLabelModal">EASY MODE</div>
    </div>
    <button id="startQuizBtn" class="start-btn">START QUIZ</button>
</div>

<div id="quizModal" class="quiz-modal">
    <div class="quiz-modal-content">
        <button id="closeModalBtn" class="close-modal-btn" aria-label="Close">×</button>
        <div class="quiz-header">
            <h2>Quiz</h2>
        </div>
        <div class="stats-row">
            <div class="score-board">Correct: <span id="modalScore">0</span> pts</div>
        </div>
        <div class="question-area">
            <div class="question-text" id="modalQuestionText">Loading general orders...</div>
            <div class="answers-grid" id="modalAnswersContainer"></div>
            <div class="feedback-area">
                <div class="feedback-message" id="modalFeedback">Select an answer</div>
                <div class="timer-info" id="modalTimerInfo">Next in --s</div>
            </div>
            <div style="margin-top: 12px; text-align: center;">
            </div>
        </div>
        <div id="modalTerminationMsg" style="padding: 0 1.5rem 1.5rem;"></div>
    </div>
</div>

<!-- Pass the questionBank data to JavaScript via a data attribute -->
<script define:vars={{ questionBank }}>
    // This script runs in the browser and has access to the questionBank prop
    const QUESTION_BANK = questionBank || { easy: [], medium: [], hard: [] };
    
    // Store it globally so the main script can access it
    window.__QUESTION_BANK = QUESTION_BANK;
</script>

<style is:inline>
    .BG555 {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1rem;
    }

    .settings-panel {
        max-width: 550px;
        width: 100%;
        background: rgba(8, 12, 25, 0.95);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(230, 178, 32, 0.5);
        border-radius: 15px;
        box-shadow: 0 25px 40px rgba(0,0,0,0.6);
        padding: 2rem 2rem 2.5rem;
        text-align: center;
        transition: 0.2s;
    }

    .settings-panel h1 {
        font-size: 1.9rem;
        letter-spacing: 1px;
        color: #e6b220;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .settings-panel p {
        color: #bbbbdd;
        margin-bottom: 2rem;
        font-weight: 500;
    }

    .difficulty-box {
        background: #07152a;
        border-radius: 15px;
        padding: 1rem 1.5rem;
        margin-bottom: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .difficulty-box label {
        font-weight: 600;
        color: #ffdd99;
        font-size: 1rem;
    }

    input[type="range"] {
        width: 240px;
        height: 6px;
        -webkit-appearance: none;
        background: #2c3e66;
        border-radius: 3px;
        outline: none;
    }

    input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 18px;
        height: 18px;
        background: #e6b220;
        border-radius: 50%;
        cursor: pointer;
        border: none;
        box-shadow: 0 0 4px rgba(0,0,0,0.5);
    }

    input[type="range"]::-moz-range-thumb {
        width: 18px;
        height: 18px;
        background: #e6b220;
        border-radius: 50%;
