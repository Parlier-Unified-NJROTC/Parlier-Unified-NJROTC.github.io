        color: white;
        cursor: pointer;
        transition: 0.2s;
    }

    .reset-quiz-btn:hover {
        background: #3a5a8c;
        transform: scale(1.02);
    }

    .close-modal-btn {
        position: absolute;
        top: 12px;
        right: 20px;
        background: none;
        border: none;
        color: #e6b220;
        font-size: 28px;
        cursor: pointer;
        font-weight: bold;
        transition: 0.2s;
    }

    .close-modal-btn:hover {
        color: #ffcd4a;
        transform: scale(1.1);
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }

    @media (max-width: 700px) {
        .answers-grid {
            grid-template-columns: 1fr;
        }
        .question-text {
            font-size: 1.1rem;
            padding: 1rem;
        }
        .stats-row {
            flex-direction: column;
            align-items: stretch;
        }
    }
</style>

<script lang="js">
    (function() {
        const QUESTION_BANK = window.__QUESTION_BANK || { easy: [], medium: [], hard: [] };
        
        // Log to verify data is loaded
        console.log('QUESTION_BANK loaded:', QUESTION_BANK);
        
        const POINTS_MAP = { 1: 1, 2: 1, 3: 1 };

        let currentDifficulty = 1;
        let currentQuestionsList = [];
        let currentQuestionObj = null;
        let currentScore = 0;
        let focusStrikeCount = 0;
        let quizActive = true;
        let waitingForNext = false;
        let autoAdvanceTimer = null;
        let countdownInterval = null;
        let hasAnsweredCurrent = false;
        
        let askedQuestionsPool = [];
        let originalQuestionsList = [];
        let quizCompleted = false;

        let modalScoreSpan, modalStrikeSpan, modalQuestionText, modalAnswersContainer, modalFeedback, modalTimerInfo, modalTerminationDiv, modalResetBtn, closeModalBtn, modalElement, statsRowElement, quizHeaderElement;

        function shuffleArray(arr) {
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        function getShuffledQuestion(originalQuestion) {
            const optionsWithFlags = originalQuestion.options.map((opt, idx) => ({
                text: opt,
                isCorrect: idx === originalQuestion.correctIndex
            }));
            
            const shuffledOptionsWithFlags = shuffleArray([...optionsWithFlags]);
            const shuffledOptions = shuffledOptionsWithFlags.map(item => item.text);
            const newCorrectIndex = shuffledOptionsWithFlags.findIndex(item => item.isCorrect === true);
            
            return {
                text: originalQuestion.text,
                options: shuffledOptions,
                correctIndex: newCorrectIndex
            };
        }

        function getDifficultyData(level) {
            if (level === 1) return { key: "easy", list: QUESTION_BANK.easy || [] };
            if (level === 2) return { key: "medium", list: QUESTION_BANK.medium || [] };
            return { key: "hard", list: QUESTION_BANK.hard || [] };
        }
        
        function getNewUnaskedQuestion() {
            if (!originalQuestionsList.length) return null;
            
            const unaskedQuestions = originalQuestionsList.filter(q => !askedQuestionsPool.includes(q));
            
            if (unaskedQuestions.length === 0) {
                return null;
            }
            
            const rand = Math.floor(Math.random() * unaskedQuestions.length);
            const rawQuestion = unaskedQuestions[rand];
            askedQuestionsPool.push(rawQuestion);
            return getShuffledQuestion(rawQuestion);
        }

        function clearAutoTimers() {
            if (autoAdvanceTimer) {
                clearTimeout(autoAdvanceTimer);
                autoAdvanceTimer = null;
            }
            if (countdownInterval) {
                clearInterval(countdownInterval);
                countdownInterval = null;
            }
            if (modalTimerInfo) modalTimerInfo.innerText = "";
            modalTimerInfo.style.opacity = '0';
        }

        function startAutoAdvance() {
            clearAutoTimers();
            let remaining = 5;
            modalTimerInfo.style.opacity = '1';
            modalTimerInfo.innerText = `Next in ${remaining}s`;
            
            countdownInterval = setInterval(() => {
                if (!quizActive || !waitingForNext) {
                    if (countdownInterval) clearInterval(countdownInterval);
                    return;
                }
                remaining--;
                if (remaining >= 0) {
                    modalTimerInfo.innerText = `Next in ${remaining}s`;
                }
                if (remaining <= 0) {
                    if (countdownInterval) clearInterval(countdownInterval);
                }
            }, 1000);
            
            autoAdvanceTimer = setTimeout(() => {
                if (quizActive && waitingForNext) {
                    loadFreshQuestion(true);
                    waitingForNext = false;
                    hasAnsweredCurrent = false;
                    modalTimerInfo.innerText = "";
                    modalTimerInfo.style.opacity = '0';
                    modalFeedback.innerText = "";
                }
                clearAutoTimers();
            }, 5500);
        }
        
        function showQuizCompletionOverview() {
            quizCompleted = true;
            quizActive = false;
            clearAutoTimers();
            
            if (statsRowElement) statsRowElement.style.display = 'none';
            if (quizHeaderElement) quizHeaderElement.style.display = 'none';
            
            const totalQuestions = originalQuestionsList.length;
            const maxPossibleScore = totalQuestions * POINTS_MAP[currentDifficulty];
            const percentage = totalQuestions > 0 ? Math.round((currentScore / maxPossibleScore) * 100) : 0;
            
            let gradeMessage = "";
            if (percentage >= 90) gradeMessage = "Outstanding! Mastery achieved!";
            else if (percentage >= 80) gradeMessage = "Excellent! Well done!";
            else if (percentage >= 70) gradeMessage = "Good job! Keep studying!";
            else if (percentage >= 60) gradeMessage = "Passing score. Review and try again!";
            else gradeMessage = "Needs improvement. Study the orders and try again!";
            
            const overviewHTML = `
                <div style="text-align: center;">
                    <h3 style="color: #e6b220; margin-bottom: 1rem;">QUIZ COMPLETED</h3>
                    <p style="font-size: 1.2rem; margin: 0.5rem 0;">Total Questions: <strong>${totalQuestions}</strong></p>
                    <p style="font-size: 1.2rem; margin: 0.5rem 0;">Correct Answer: <strong>${currentScore} / ${maxPossibleScore}</strong></p>
                    <p style="font-size: 1.2rem; margin: 0.5rem 0;">Percentage: <strong>${percentage}%</strong></p>
                    <p style="font-size: 1.1rem; margin: 1rem 0; color: #d4e6ff;">${gradeMessage}</p>
                    <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 1rem;">
                        <button id="completionRestartBtn" class="start-btn" style="background: #2c3e66; padding: 0.6rem 1.5rem; width: auto;">RESTART QUIZ</button>
                        <button id="completionCloseBtn" class="start-btn" style="background: #e6b220; padding: 0.6rem 1.5rem; width: auto;">CLOSE</button>
                    </div>
                </div>
            `;
            
            modalQuestionText.innerText = "";
            modalAnswersContainer.innerHTML = overviewHTML;
            modalFeedback.innerText = "";
            modalTimerInfo.innerText = "";
            modalTimerInfo.style.opacity = '0';
            
            const restartBtn = document.getElementById('completionRestartBtn');
            const closeBtn = document.getElementById('completionCloseBtn');
            
            if (restartBtn) {
                restartBtn.addEventListener('click', () => {
                    resetQuizInsideModal();
                });
            }
            if (closeBtn) {
                closeBtn.addEventListener('click', () => {
                    closeModal();
                    document.getElementById('settingsPanel').style.display = 'block';
                });
            }
        }

        function loadFreshQuestion(resetAnswerState = true) {
            if (!quizActive) return;
            
            const newQ = getNewUnaskedQuestion();
            
            if (newQ === null) {
                showQuizCompletionOverview();
                return;
            }
            
            currentQuestionObj = newQ;
            
            if (resetAnswerState) {
                hasAnsweredCurrent = false;
                waitingForNext = false;
                clearAutoTimers();
                modalTimerInfo.innerText = "";
                modalTimerInfo.style.opacity = '0';
            }
            renderQuestion();
        }

        function renderQuestion() {
            if (!quizActive) return;
            if (quizCompleted) return;
            if (!currentQuestionObj) {
                loadFreshQuestion();
                return;
            }
            modalQuestionText.innerText = currentQuestionObj.text;
            modalAnswersContainer.innerHTML = '';
            
            currentQuestionObj.options.forEach((opt, idx) => {
                const btn = document.createElement('div');
                btn.className = 'answer-btn';
                btn.innerText = opt;
                btn.setAttribute('data-index', idx);
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    onAnswer(parseInt(this.getAttribute('data-index')));
                });
                if (hasAnsweredCurrent || waitingForNext || !quizActive) {
                    btn.style.pointerEvents = 'none';
                }
                modalAnswersContainer.appendChild(btn);
            });
            
            if (!hasAnsweredCurrent && !waitingForNext) {
                modalFeedback.innerText = "";
            }
        }

        function onAnswer(selectedIdx) {
            if (!quizActive || hasAnsweredCurrent || waitingForNext || quizCompleted) return;
            
            const isCorrect = (selectedIdx === currentQuestionObj.correctIndex);
            const allBtns = document.querySelectorAll('#modalAnswersContainer .answer-btn');
            
            allBtns.forEach((btn, idx) => {
                btn.style.pointerEvents = 'none';
                if (idx === currentQuestionObj.correctIndex) {
                    btn.classList.add('selected-correct');
                }
                if (idx === selectedIdx && !isCorrect) {
                    btn.classList.add('selected-wrong');
                }
            });
            
            if (isCorrect) {
                let points = POINTS_MAP[currentDifficulty];
                currentScore += points;
                if (modalScoreSpan) modalScoreSpan.innerText = currentScore;
                modalFeedback.innerText = `CORRECT! +${points} points. Next question in 5 seconds.`;
            } else {
                const correctAns = currentQuestionObj.options[currentQuestionObj.correctIndex];
                modalFeedback.innerText = `WRONG! Correct answer: "${correctAns}". Next in 5 seconds.`;
            }
            
            hasAnsweredCurrent = true;
            waitingForNext = true;
            startAutoAdvance();
        }

        function applyFocusStrike() {
            if (!quizActive || quizCompleted) return;
            if (focusStrikeCount >= 3) return;
            
            focusStrikeCount++;
            const remaining = 3 - focusStrikeCount;
            modalFeedback.innerText = `FOCUS LOST! Question changes immediately. (${remaining} strike(s) left)`;
            
            if (waitingForNext) {
                clearAutoTimers();
                waitingForNext = false;
            }
            
            if (quizActive && !quizCompleted) {
                if (currentQuestionObj) {
                    const originalQ = originalQuestionsList.find(q => q.text === currentQuestionObj.text);
                    if (originalQ) {
                        const indexInAsked = askedQuestionsPool.indexOf(originalQ);
                        if (indexInAsked !== -1) {
                            askedQuestionsPool.splice(indexInAsked, 1);
                        }
                    }
                }
                loadFreshQuestion(true);
                hasAnsweredCurrent = false;
                waitingForNext = false;
                modalTimerInfo.innerText = "";
            }
            
            if (focusStrikeCount >= 3) {
                terminateAndCloseModal();
            }
        }

        function terminateAndCloseModal() {
            if (!quizActive) return;
            quizActive = false;
            clearAutoTimers();
            modalTerminationDiv.innerHTML = `<div style="background:#b91c1ccc; border-radius:15px; padding:12px; text-align:center; margin-top: 10px;">TEST TERMINATED: Maximum focus strikes (3). Closing quiz popup.</div>`;
            if (modalAnswersContainer) {
                const btns = modalAnswersContainer.querySelectorAll('.answer-btn');
                btns.forEach(btn => {
                    btn.style.pointerEvents = 'none';
                });
            }
            setTimeout(() => {
                closeModal();
            }, 1800);
        }

        function resetQuizInsideModal() {
            if (!modalElement || modalElement.style.display !== 'flex') return;
            
            currentScore = 0;
            focusStrikeCount = 0;
            quizActive = true;
            waitingForNext = false;
            hasAnsweredCurrent = false;
            quizCompleted = false;
            askedQuestionsPool = [];
            
            if (statsRowElement) statsRowElement.style.display = 'flex';
            if (quizHeaderElement) quizHeaderElement.style.display = 'block';
            
            clearAutoTimers();
            if (modalScoreSpan) modalScoreSpan.innerText = "0";
            if (modalStrikeSpan) modalStrikeSpan.innerText = "0";
            modalTerminationDiv.innerHTML = "";
            
            const diffData = getDifficultyData(currentDifficulty);
            originalQuestionsList = [...diffData.list];
            currentQuestionsList = originalQuestionsList;
            
            const firstRawQ = originalQuestionsList.length > 0 ? originalQuestionsList[0] : null;
            if (firstRawQ) {
                askedQuestionsPool.push(firstRawQ);
                currentQuestionObj = getShuffledQuestion(firstRawQ);
            } else {
                currentQuestionObj = null;
            }
            
            renderQuestion();
            modalFeedback.innerText = "";
            modalTimerInfo.innerText = "";
            modalTimerInfo.style.opacity = '0';
        }

        function closeModal() {
            if (!modalElement) return;
            clearAutoTimers();
            modalElement.style.display = 'none';
            window.removeEventListener('blur', blurHandler);
            document.removeEventListener('visibilitychange', visibilityHandler);
            const settingsPanel = document.getElementById('settingsPanel');
            if (settingsPanel) settingsPanel.style.display = 'block';
            quizActive = false;
        }

        let blurHandler = function() { 
            if (modalElement && modalElement.style.display === 'flex' && quizActive && !quizCompleted) applyFocusStrike(); 
        };
        
        let visibilityHandler = function() { 
            if (document.hidden && modalElement && modalElement.style.display === 'flex' && quizActive && !quizCompleted) applyFocusStrike(); 
        };

        function openModal() {
            const settingsSlider = document.getElementById('difficultySliderModal');
            const diffVal = parseInt(settingsSlider.value);
            currentDifficulty = diffVal;
            const diffData = getDifficultyData(currentDifficulty);
            originalQuestionsList = [...diffData.list];
            currentQuestionsList = originalQuestionsList;
            currentScore = 0;
            focusStrikeCount = 0;
            quizActive = true;
            waitingForNext = false;
            hasAnsweredCurrent = false;
            quizCompleted = false;
            askedQuestionsPool = [];
            
            if (statsRowElement) statsRowElement.style.display = 'flex';
            if (quizHeaderElement) quizHeaderElement.style.display = 'block';
            
            clearAutoTimers();
            if (modalScoreSpan) modalScoreSpan.innerText = "0";
            if (modalStrikeSpan) modalStrikeSpan.innerText = "0";
            modalTerminationDiv.innerHTML = "";
            
            const firstRawQ = originalQuestionsList.length > 0 ? originalQuestionsList[0] : null;
            if (firstRawQ) {
                askedQuestionsPool.push(firstRawQ);
                currentQuestionObj = getShuffledQuestion(firstRawQ);
            } else {
                currentQuestionObj = null;
            }
            
            renderQuestion();
            modalFeedback.innerText = "";
            modalTimerInfo.innerText = "";
            modalElement.style.display = 'flex';
            window.addEventListener('blur', blurHandler);
            document.addEventListener('visibilitychange', visibilityHandler);
        }

        document.addEventListener('DOMContentLoaded', function() {
            modalElement = document.getElementById('quizModal');
            modalScoreSpan = document.getElementById('modalScore');
            modalStrikeSpan = document.getElementById('modalStrike');
            modalQuestionText = document.getElementById('modalQuestionText');
            modalAnswersContainer = document.getElementById('modalAnswersContainer');
            modalFeedback = document.getElementById('modalFeedback');
            modalTimerInfo = document.getElementById('modalTimerInfo');
            modalTerminationDiv = document.getElementById('modalTerminationMsg');
            modalResetBtn = document.getElementById('modalResetInsideBtn');
            closeModalBtn = document.getElementById('closeModalBtn');
            statsRowElement = document.querySelector('.stats-row');
            quizHeaderElement = document.querySelector('.quiz-header');

            const startBtn = document.getElementById('startQuizBtn');
            const diffSliderSettings = document.getElementById('difficultySliderModal');
            const diffLabelSettings = document.getElementById('difficultyLabelModal');
            
            function updateSettingsLabel() {
                const val = parseInt(diffSliderSettings.value);
                if (val === 1) diffLabelSettings.innerText = "EASY MODE";
                else if (val === 2) diffLabelSettings.innerText = "MEDIUM MODE";
                else diffLabelSettings.innerText = "HARD MODE";
            }
            
            diffSliderSettings.addEventListener('input', updateSettingsLabel);
            updateSettingsLabel();
            
            startBtn.addEventListener('click', function() {
                document.getElementById('settingsPanel').style.display = 'none';
                openModal();
            });
            
            if (modalResetBtn) {
                modalResetBtn.addEventListener('click', resetQuizInsideModal);
            }
            if (closeModalBtn) {
                closeModalBtn.addEventListener('click', function() {
                    closeModal();
                    document.getElementById('settingsPanel').style.display = 'block';
                });
            }
            
            const originalBodyOverflow = document.body.style.overflow;
            const modalObserver = new MutationObserver((mutations) => {
                mutations.forEach((mut) => {
                    if (mut.type === 'attributes' && mut.attributeName === 'style') {
                        if (modalElement && modalElement.style.display === 'flex') {
                            document.body.style.overflow = 'hidden';
                        } else {
                            document.body.style.overflow = originalBodyOverflow || '';
                        }
                    }
                });
            });
            if (modalElement) {
                modalObserver.observe(modalElement, { attributes: true });
                if (modalElement.style.display === 'flex') document.body.style.overflow = 'hidden';
                else document.body.style.overflow = originalBodyOverflow || '';
            }
        });
    })();
</script>