---
// components/quiz.astro


// STYLE IMPORT

import "../style/quiz.css";


// PROPS

export interface Props {
  questionBank?: {
    easy: any[];
    medium: any[];
    hard: any[];
  };
  QUIZ: string;
}
const {
    QUIZ,
} = Astro.props;

const { questionBank } = Astro.props;
---

<!-- 
     SETTINGS PANEL (shown before quiz starts)
     - Title, difficulty slider, START QUIZ button
      -->
<div id="settingsPanel" class="settings-panel">
    <h1>{QUIZ} ORDERS</h1>
    <p>Configure difficulty & start quiz</p>
    <div class="difficulty-box">
        <label>DIFFICULTY LEVEL</label>
        <input type="range" id="difficultySliderModal" min="1" max="3" step="1" value="1">
        <div class="difficulty-value" id="difficultyLabelModal">EASY MODE</div>
    </div>
    <button id="startQuizBtn" class="start-btn">START QUIZ</button>
</div>

<!-- 
     QUIZ MODAL (fullscreen overlay)
     Contains: header, stats, question, answers grid, feedback,
               termination message area
      -->
<div id="quizModal" class="quiz-modal">
    <div class="quiz-modal-content">
        <!-- Close button (×) -->
        <button id="closeModalBtn" class="close-modal-btn" aria-label="Close">×</button>

        <!-- Quiz header -->
        <div class="quiz-header">
            <h2>Quiz</h2>
        </div>

        <!-- Score / stats bar -->
        <div class="stats-row">
            <div class="score-board">Correct: <span id="modalScore">0</span> pts</div>
        </div>

        <!-- Question + answers + feedback -->
        <div class="question-area">
            <div class="question-text" id="modalQuestionText">Loading general orders...</div>
            <div class="answers-grid" id="modalAnswersContainer"></div>
            <div class="feedback-area">
                <div class="feedback-message" id="modalFeedback">Select an answer</div>
                <div class="timer-info" id="modalTimerInfo">Next in --s</div>
            </div>
            <div style="margin-top: 12px; text-align: center;">
            </div>
        </div>

        <!-- Termination message area (3 focus strikes) -->
        <div id="modalTerminationMsg" style="padding: 0 1.5rem 1.5rem;"></div>
    </div>
</div>

<!-- 
     QUESTION BANK BRIDGE
     Serializes the Astro `questionBank` prop into a global
     so the client-side script can read it.
      -->
<script define:vars={{ questionBank }}>
    const QUESTION_BANK = questionBank || { easy: [], medium: [], hard: [] };
    window.__QUESTION_BANK = QUESTION_BANK;
</script>

<script lang="js">
    (function() {

        // 1. DATA + CONSTANTS
        
        const QUESTION_BANK = window.__QUESTION_BANK || { easy: [], medium: [], hard: [] };
        
        console.log('QUESTION_BANK loaded:', QUESTION_BANK);
        
        const POINTS_MAP = { 1: 1, 2: 1, 3: 1 };

        // 2. STATE VARIABLES
        
        let currentDifficulty = 1;          // 1=easy, 2=medium, 3=hard
        let currentQuestionsList = [];      // active difficulty list
        let currentQuestionObj = null;      // currently displayed question
        let currentScore = 0;               // running score
        let focusStrikeCount = 0;           // tab-blur strikes (max 3)
        let quizActive = true;              // quiz is running
        let waitingForNext = false;         // showing feedback, waiting for advance
        let autoAdvanceTimer = null;        // 5s advance timer
        let countdownInterval = null;       // countdown ticker
        let hasAnsweredCurrent = false;     // current Q already answered
        
        let askedQuestionsPool = [];        // questions already served
        let originalQuestionsList = [];     // raw list for current difficulty
        let quizCompleted = false;          // finished overview state

        let answerHistory = [];             // every answered Q for the review

        
        // 3. DOM REFERENCES (assigned in DOMContentLoaded)
        
        let modalScoreSpan, modalStrikeSpan, modalQuestionText, modalAnswersContainer,
            modalFeedback, modalTimerInfo, modalTerminationDiv, modalResetBtn,
            closeModalBtn, modalElement, statsRowElement, quizHeaderElement;

        // 4. UTILITY HELPERS

        // Escape user-facing text before injecting into innerHTML
        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        // Fisher-Yates shuffle (in place)
        function shuffleArray(arr) {
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        // Shuffle a question's options while tracking the correct index
        function getShuffledQuestion(originalQuestion) {
            const optionsWithFlags = originalQuestion.options.map((opt, idx) => ({
                text: opt,
                isCorrect: idx === originalQuestion.correctIndex
            }));
            
            const shuffledOptionsWithFlags = shuffleArray([...optionsWithFlags]);
            const shuffledOptions = shuffledOptionsWithFlags.map(item => item.text);
            const newCorrectIndex = shuffledOptionsWithFlags.findIndex(item => item.isCorrect === true);
            
            return {
                text: originalQuestion.text,
                options: shuffledOptions,
                correctIndex: newCorrectIndex
            };
        }

        // Resolve the difficulty key + list from QUESTION_BANK
        function getDifficultyData(level) {
            if (level === 1) return { key: "easy", list: QUESTION_BANK.easy || [] };
            if (level === 2) return { key: "medium", list: QUESTION_BANK.medium || [] };
            return { key: "hard", list: QUESTION_BANK.hard || [] };
        }
        
        // Pick a random unasked question, mark it asked, return shuffled copy
        function getNewUnaskedQuestion() {
            if (!originalQuestionsList.length) return null;
            
            const unaskedQuestions = originalQuestionsList.filter(q => !askedQuestionsPool.includes(q));
            
            if (unaskedQuestions.length === 0) {
                return null;
            }
            
            const rand = Math.floor(Math.random() * unaskedQuestions.length);
            const rawQuestion = unaskedQuestions[rand];
            askedQuestionsPool.push(rawQuestion);
            return getShuffledQuestion(rawQuestion);
        }

        
        // 5. TIMER MANAGEMENT
        
        function clearAutoTimers() {
            if (autoAdvanceTimer) {
                clearTimeout(autoAdvanceTimer);
                autoAdvanceTimer = null;
            }
            if (countdownInterval) {
                clearInterval(countdownInterval);
                countdownInterval = null;
            }
            if (modalTimerInfo) modalTimerInfo.innerText = "";
            if (modalTimerInfo) modalTimerInfo.style.opacity = '0';
        }

        // Start 5-second countdown + auto-advance to next question
        function startAutoAdvance() {
            clearAutoTimers();
            let remaining = 5;
            modalTimerInfo.style.opacity = '1';
            modalTimerInfo.innerText = `Next in ${remaining}s`;
            
            countdownInterval = setInterval(() => {
                if (!quizActive || !waitingForNext) {
                    if (countdownInterval) clearInterval(countdownInterval);
                    return;
                }
                remaining--;
                if (remaining >= 0) {
                    modalTimerInfo.innerText = `Next in ${remaining}s`;
                }
                if (remaining <= 0) {
                    if (countdownInterval) clearInterval(countdownInterval);
                }
            }, 1000);
            
            autoAdvanceTimer = setTimeout(() => {
                if (quizActive && waitingForNext) {
                    loadFreshQuestion(true);
                    waitingForNext = false;
                    hasAnsweredCurrent = false;
                    modalTimerInfo.innerText = "";
                    modalTimerInfo.style.opacity = '0';
                    modalFeedback.innerText = "";
                }
                clearAutoTimers();
            }, 5500);
        }

        
        // 6. LAYOUT HELPERS (grid + wrapper stacking)
        

        // Restore 2-column layout for the answers grid
        function restoreAnswersGrid() {
            const gridAnswers = document.querySelector('.answers-grid');
            if (gridAnswers) {
                gridAnswers.style.gridTemplateColumns = '';
            }
        }

        // Raise the .BG555 wrapper so quiz stacks above page content
        function raiseBgWrapper() {
            const bgWrapper = document.querySelector('.BG555');
            if (bgWrapper) {
                bgWrapper.classList.add('quiz-active');
            }
        }

        // Drop the forward stacking when quiz closes
        function lowerBgWrapper() {
            const bgWrapper = document.querySelector('.BG555');
            if (bgWrapper) {
                bgWrapper.classList.remove('quiz-active');
            }
        }

        // 7. COMPLETION OVERVIEW
        // Renders final score, grade, and per-question review
        
        function showQuizCompletionOverview() {
            quizCompleted = true;
            quizActive = false;
            clearAutoTimers();
            
            if (statsRowElement) statsRowElement.style.display = 'none';
            if (quizHeaderElement) quizHeaderElement.style.display = 'none';
            
            // Collapse grid to single column for overview
            const gridAnswers = document.querySelector('.answers-grid');
            if (gridAnswers) {
                gridAnswers.style.gridTemplateColumns = '1fr';
            }
            
            // ---- Compute score + grade ----
            const totalQuestions = originalQuestionsList.length;
            const maxPossibleScore = totalQuestions * POINTS_MAP[currentDifficulty];
            const percentage = totalQuestions > 0 ? Math.round((currentScore / maxPossibleScore) * 100) : 0;
            const totalAnswered = answerHistory.length;
            const totalWrong = answerHistory.filter(a => !a.isCorrect).length;
            
            let gradeMessage = "";
            let gradeColor = "#e6b220";
            
            if (percentage >= 100) {
                gradeMessage = "Outstanding! Mastery achieved!";
                gradeColor = "#2ecc71";
            } else if (percentage >= 80) {
                gradeMessage = "Excellent! Well done!";
                gradeColor = "#2ecc71";
            } else if (percentage >= 70) {
                gradeMessage = "Good job! Keep studying!";
                gradeColor = "#e6b220";
            } else if (percentage >= 60) {
                gradeMessage = "Passing score. Review and try again!";
                gradeColor = "#f39c12";
            } else {
                gradeMessage = "Needs improvement. Study the orders and try again!";
                gradeColor = "#e74c3c";
            }
            
            // ---- Build per-question review list ----
            let reviewHTML = "";
            if (answerHistory.length > 0) {
                const items = answerHistory.map((entry, i) => {
                    const itemClass = entry.isCorrect ? 'correct' : 'wrong';
                    const selectedClass = entry.isCorrect ? 'correct-text' : 'wrong-text';
                    const selectedLabel = entry.selectedText;
                    const correctLabel = entry.options[entry.correctIndex];
                    
                    return `
                        <div class="review-item ${itemClass}">
                            <div class="review-question">
                                <span class="review-number">${i + 1}.</span>${escapeHtml(entry.text)}
                            </div>
                            <div class="review-answers">
                                <div class="review-answer-row">
                                    <span class="review-answer-label">Your answer:</span>
                                    <span class="review-answer-text ${selectedClass}">${escapeHtml(selectedLabel)}</span>
                                </div>
                                ${!entry.isCorrect ? `
                                <div class="review-answer-row">
                                    <span class="review-answer-label">Correct answer:</span>
                                    <span class="review-answer-text correct-text">${escapeHtml(correctLabel)}</span>
                                </div>` : ''}
                            </div>
                        </div>
                    `;
                }).join('');
                
                reviewHTML = `
                    <div class="review-section">
                        <div class="review-title">Answer Review (${totalWrong} incorrect of ${totalAnswered})</div>
                        <div class="review-list">
                            ${items}
                        </div>
                    </div>
                `;
            }
            
            // ---- Assemble overview ----
            const overviewHTML = `
                <div class="completion-overview">
                    <h3 class="completion-title">QUIZ COMPLETED</h3>
                    
                    <div class="completion-stats">
                        <div class="stat-card">
                            <span class="stat-value">${totalQuestions}</span>
                            <span class="stat-label">Total Questions</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-value">${currentScore}</span>
                            <span class="stat-label">Correct Answers</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-value" style="color: ${gradeColor}">${percentage}%</span>
                            <span class="stat-label">Score</span>
                        </div>
                    </div>
                    
                    <div class="completion-bar-wrapper">
                        <div class="completion-bar" style="width: ${percentage}%; background: ${gradeColor};"></div>
                    </div>
                    
                    <p class="completion-message" style="color: ${gradeColor}">${gradeMessage}</p>
                    
                    <div class="completion-actions">
                        <button id="completionRestartBtn" class="completion-btn restart-btn">RESTART QUIZ</button>
                        <button id="completionCloseBtn" class="completion-btn close-btn">CLOSE</button>
                    </div>
                    
                    ${reviewHTML}
                </div>
            `;
            
            modalQuestionText.innerText = "";
            modalAnswersContainer.innerHTML = overviewHTML;
            modalFeedback.innerText = "";
            modalTimerInfo.innerText = "";
            modalTimerInfo.style.opacity = '0';
            
            // ---- Wire overview buttons ----
            const restartBtn = document.getElementById('completionRestartBtn');
            const closeBtn = document.getElementById('completionCloseBtn');
            
            if (restartBtn) {
                restartBtn.addEventListener('click', () => {
                    resetQuizInsideModal();
                });
            }
            if (closeBtn) {
                closeBtn.addEventListener('click', () => {
                    closeModal();
                    const settingsPanel = document.getElementById('settingsPanel');
                    if (settingsPanel) settingsPanel.style.display = 'block';
                });
            }
        }
        
        // 8. QUESTION FLOW

        // Load next unasked question (or show overview if exhausted)
        function loadFreshQuestion(resetAnswerState = true) {
            if (!quizActive) return;
            
            const newQ = getNewUnaskedQuestion();
            
            if (newQ === null) {
                showQuizCompletionOverview();
                return;
            }
            
            currentQuestionObj = newQ;
            
            if (resetAnswerState) {
                hasAnsweredCurrent = false;
                waitingForNext = false;
                clearAutoTimers();
                modalTimerInfo.innerText = "";
                modalTimerInfo.style.opacity = '0';
            }
            renderQuestion();
        }

        // Paint the current question + answer buttons
        function renderQuestion() {
            if (!quizActive) return;
            if (quizCompleted) return;
            if (!currentQuestionObj) {
                loadFreshQuestion();
                return;
            }
            modalQuestionText.innerText = currentQuestionObj.text;
            modalAnswersContainer.innerHTML = '';
            
            currentQuestionObj.options.forEach((opt, idx) => {
                const btn = document.createElement('div');
                btn.className = 'answer-btn';
                btn.innerText = opt;
                btn.setAttribute('data-index', idx);
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    onAnswer(parseInt(this.getAttribute('data-index')));
                });
                if (hasAnsweredCurrent || waitingForNext || !quizActive) {
                    btn.style.pointerEvents = 'none';
                }
                modalAnswersContainer.appendChild(btn);
            });
            
            if (!hasAnsweredCurrent && !waitingForNext) {
                modalFeedback.innerText = "";
            }
        }

        // Handle an answer click: score, highlight, record, schedule next
        function onAnswer(selectedIdx) {
            if (!quizActive || hasAnsweredCurrent || waitingForNext || quizCompleted) return;
            
            const isCorrect = (selectedIdx === currentQuestionObj.correctIndex);
            const allBtns = document.querySelectorAll('#modalAnswersContainer .answer-btn');
            
            // Highlight correct + wrong choices
            allBtns.forEach((btn, idx) => {
                btn.style.pointerEvents = 'none';
                if (idx === currentQuestionObj.correctIndex) {
                    btn.classList.add('selected-correct');
                }
                if (idx === selectedIdx && !isCorrect) {
                    btn.classList.add('selected-wrong');
                }
            });
            
            // Record into history for the overview review
            answerHistory.push({
                text: currentQuestionObj.text,
                options: [...currentQuestionObj.options],
                correctIndex: currentQuestionObj.correctIndex,
                selectedIndex: selectedIdx,
                selectedText: currentQuestionObj.options[selectedIdx],
                isCorrect: isCorrect
            });
            
            // Feedback + scoring
            if (isCorrect) {
                let points = POINTS_MAP[currentDifficulty];
                currentScore += points;
                if (modalScoreSpan) modalScoreSpan.innerText = currentScore;
                modalFeedback.innerText = `CORRECT! +${points} points. Next question in 5 seconds.`;
            } else {
                const correctAns = currentQuestionObj.options[currentQuestionObj.correctIndex];
                modalFeedback.innerText = `WRONG! Correct answer: "${correctAns}". Next in 5 seconds.`;
            }
            
            hasAnsweredCurrent = true;
            waitingForNext = true;
            startAutoAdvance();
        }

        // 9. FOCUS-STRIKE SYSTEM (tab blur / visibility change)
        
        function applyFocusStrike() {
            if (!quizActive || quizCompleted) return;
            if (focusStrikeCount >= 3) return;
            
            focusStrikeCount++;
            const remaining = 3 - focusStrikeCount;
            modalFeedback.innerText = `FOCUS LOST! Question changes immediately. (${remaining} strike(s) left)`;
            
            if (waitingForNext) {
                clearAutoTimers();
                waitingForNext = false;
            }
            
            if (quizActive && !quizCompleted) {
                // Return the current question to the pool
                if (currentQuestionObj) {
                    const originalQ = originalQuestionsList.find(q => q.text === currentQuestionObj.text);
                    if (originalQ) {
                        const indexInAsked = askedQuestionsPool.indexOf(originalQ);
                        if (indexInAsked !== -1) {
                            askedQuestionsPool.splice(indexInAsked, 1);
                        }
                    }
                }
                loadFreshQuestion(true);
                hasAnsweredCurrent = false;
                waitingForNext = false;
                modalTimerInfo.innerText = "";
            }
            
            // 3rd strike ends the quiz
            if (focusStrikeCount >= 3) {
                terminateAndCloseModal();
            }
        }

        // Hard-terminate: show message, disable buttons, close after 1.8s
        function terminateAndCloseModal() {
            if (!quizActive) return;
            quizActive = false;
            clearAutoTimers();
            modalTerminationDiv.innerHTML = `<div style="background:#b91c1ccc; border-radius:15px; padding:12px; text-align:center; margin-top: 10px;">TEST TERMINATED: Maximum focus strikes (3). Closing quiz popup.</div>`;
            if (modalAnswersContainer) {
                const btns = modalAnswersContainer.querySelectorAll('.answer-btn');
                btns.forEach(btn => {
                    btn.style.pointerEvents = 'none';
                });
            }
            setTimeout(() => {
                closeModal();
            }, 1800);
        }
        // 10. LIFECYCLE (open / reset / close)

        // Restart quiz from the overview without closing modal
        function resetQuizInsideModal() {
            if (!modalElement || modalElement.style.display !== 'flex') return;
            
            currentScore = 0;
            focusStrikeCount = 0;
            quizActive = true;
            waitingForNext = false;
            hasAnsweredCurrent = false;
            quizCompleted = false;
            askedQuestionsPool = [];
            answerHistory = [];
            
            if (statsRowElement) statsRowElement.style.display = 'flex';
            if (quizHeaderElement) quizHeaderElement.style.display = 'block';
            
            clearAutoTimers();
            if (modalScoreSpan) modalScoreSpan.innerText = "0";
            if (modalStrikeSpan) modalStrikeSpan.innerText = "0";
            modalTerminationDiv.innerHTML = "";
            
            const diffData = getDifficultyData(currentDifficulty);
            originalQuestionsList = [...diffData.list];
            currentQuestionsList = originalQuestionsList;
            
            restoreAnswersGrid();
            raiseBgWrapper();
            
            renderQuestion();
            modalFeedback.innerText = "";
            modalTimerInfo.innerText = "";
            modalTimerInfo.style.opacity = '0';
        }

        // Close modal, restore layout, show settings panel
        function closeModal() {
            if (!modalElement) return;
            clearAutoTimers();
            restoreAnswersGrid();
            lowerBgWrapper();
            modalElement.style.display = 'none';
            window.removeEventListener('blur', blurHandler);
            document.removeEventListener('visibilitychange', visibilityHandler);
            const settingsPanel = document.getElementById('settingsPanel');
            if (settingsPanel) settingsPanel.style.display = 'block';
            quizActive = false;
        }

        // Focus-strike triggers
        let blurHandler = function() { 
            if (modalElement && modalElement.style.display === 'flex' && quizActive && !quizCompleted) applyFocusStrike(); 
        };
        
        let visibilityHandler = function() { 
            if (document.hidden && modalElement && modalElement.style.display === 'flex' && quizActive && !quizCompleted) applyFocusStrike(); 
        };

        // Start a fresh quiz from the settings panel
        function openModal() {
            const settingsSlider = document.getElementById('difficultySliderModal');
            const diffVal = parseInt(settingsSlider.value);
            currentDifficulty = diffVal;
            const diffData = getDifficultyData(currentDifficulty);
            originalQuestionsList = [...diffData.list];
            currentQuestionsList = originalQuestionsList;
            currentScore = 0;
            focusStrikeCount = 0;
            quizActive = true;
            waitingForNext = false;
            hasAnsweredCurrent = false;
            quizCompleted = false;
            askedQuestionsPool = [];
            answerHistory = [];
            
            if (statsRowElement) statsRowElement.style.display = 'flex';
            if (quizHeaderElement) quizHeaderElement.style.display = 'block';
            
            clearAutoTimers();
            if (modalScoreSpan) modalScoreSpan.innerText = "0";
            if (modalStrikeSpan) modalStrikeSpan.innerText = "0";
            modalTerminationDiv.innerHTML = "";
            
            currentQuestionObj = getNewUnaskedQuestion();
            
            restoreAnswersGrid();
            raiseBgWrapper();
            
            renderQuestion();
            modalFeedback.innerText = "";
            modalTimerInfo.innerText = "";
            modalElement.style.display = 'flex';
            window.addEventListener('blur', blurHandler);
            document.addEventListener('visibilitychange', visibilityHandler);
        }
        // 11. BOOTSTRAP (DOMContentLoaded)
        document.addEventListener('DOMContentLoaded', function() {
            // Cache DOM refs
            modalElement = document.getElementById('quizModal');
            modalScoreSpan = document.getElementById('modalScore');
            modalStrikeSpan = document.getElementById('modalStrike');
            modalQuestionText = document.getElementById('modalQuestionText');
            modalAnswersContainer = document.getElementById('modalAnswersContainer');
            modalFeedback = document.getElementById('modalFeedback');
            modalTimerInfo = document.getElementById('modalTimerInfo');
            modalTerminationDiv = document.getElementById('modalTerminationMsg');
            modalResetBtn = document.getElementById('modalResetInsideBtn');
            closeModalBtn = document.getElementById('closeModalBtn');
            statsRowElement = document.querySelector('.stats-row');
            quizHeaderElement = document.querySelector('.quiz-header');

            const startBtn = document.getElementById('startQuizBtn');
            const diffSliderSettings = document.getElementById('difficultySliderModal');
            const diffLabelSettings = document.getElementById('difficultyLabelModal');
            
            // Difficulty label updater
            function updateSettingsLabel() {
                const val = parseInt(diffSliderSettings.value);
                if (val === 1) diffLabelSettings.innerText = "EASY MODE";
                else if (val === 2) diffLabelSettings.innerText = "MEDIUM MODE";
                else diffLabelSettings.innerText = "HARD MODE";
            }
            
            diffSliderSettings.addEventListener('input', updateSettingsLabel);
            updateSettingsLabel();
            
            // START button → hide settings, open quiz
            startBtn.addEventListener('click', function() {
                document.getElementById('settingsPanel').style.display = 'none';
                openModal();
            });
            
            if (modalResetBtn) {
                modalResetBtn.addEventListener('click', resetQuizInsideModal);
            }
            if (closeModalBtn) {
                closeModalBtn.addEventListener('click', function() {
                    closeModal();
                    document.getElementById('settingsPanel').style.display = 'block';
                });
            }
            
            // Lock/unlock body scroll based on modal visibility
            const originalBodyOverflow = document.body.style.overflow;
            const modalObserver = new MutationObserver((mutations) => {
                mutations.forEach((mut) => {
                    if (mut.type === 'attributes' && mut.attributeName === 'style') {
                        if (modalElement && modalElement.style.display === 'flex') {
                            document.body.style.overflow = 'hidden';
                        } else {
                            document.body.style.overflow = originalBodyOverflow || '';
                        }
                    }
                });
            });
            if (modalElement) {
                modalObserver.observe(modalElement, { attributes: true });
                if (modalElement.style.display === 'flex') document.body.style.overflow = 'hidden';
                else document.body.style.overflow = originalBodyOverflow || '';
            }
        });
    })();
</script>